# Copy to .env next to compose.yaml and fill in. Every variable compose.yaml uses is here.

# ---- Image (ghcr.io/fatoyo/socrates)
# A release such as 1.0, the newest 1.x with 1, or latest
SOCRATES_VERSION=latest

# ---- Network
# Name of the Docker bridge on the server and its private subnet. Pick a subnet that no
# other Docker network or your LAN uses.
BRIDGE_NAME=br-socrates
SUBNET=172.30.30.0/24

# IP addresses OF THE SERVER that runs this container. The app is published only on these
# addresses, so it is reachable from your LAN and over Tailscale but not on any other
# network interface of the server.
#   HOST_IP: the server's LAN address. Find it on the server with: ip -4 addr
#            Use 127.0.0.1 to allow access only from the server itself.
#   TS_IP:   the server's Tailscale address (100.x.y.z). Find it with: tailscale ip -4
#            Remove TS_IP together with its port line in compose.yaml if the app isn't
#            published on Tailscale.
# HOST_IP and TS_IP must be different addresses; the same address twice fails to start.
HOST_IP=192.168.1.10
TS_IP=100.64.0.10
# Port on the server, so the app opens at http://<HOST_IP>:<PORT>
PORT=3141

# ---- User the container runs as: the owner of the NFS folders below
PUID=1001
PGID=1001

# ---- Time zone (also the default for the schedule on the Settings page)
TZ=Europe/Amsterdam

# ---- NFS folders on the server, mounted into the container
# In the app's Settings page enter /archive/arrays and /archive/blog
ARRAYS_LOCATION=/mnt/nfs/socrates/SOC
BLOG_LOCATION=/mnt/nfs/socrates/blog

# ---- Limits (Chromium uses a few hundred MB during a download)
MEM_LIMIT=2g
PIDS_LIMIT=512
